            "length": 1,
            "format": [
                "1", "1", "1", "0", "DRG", "SR1", "SR2", "SR3"
            ],
            "description": "Register Extension Prefix - if any bits in the REX prefix are set, the instruction extends that register fields to allow access 16-31 of the 32-bit general-purpose registers."
        }
