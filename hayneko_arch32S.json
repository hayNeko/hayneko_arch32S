    "architecture": {
        "name": "Hayneko_Arch32S",
        "architecture": "RISC-like, Harvard architecture",
        "copyright": "Copyright (c) 2025 Hayneko, all rights reserved.",
        "opensource_license": {
            "name": "MIT"
        },
        "document": "HAYNEKO_ARCH32S_DOC.md",
        "bit_size": 32,
        "endian": "little",
        "is_support_fpu": true,
        "description": "Hayneko_Arch32S is a 32-bit RISC-like architecture with a Harvard architecture design, supporting floating-point operations. It is designed for efficient performance and low power consumption.",
        "hardware_info": {
            "GPR": 32,
            "FPR": 32,
            "CR": 4,
            "memory_size": 4294967296,
            "instruction_length_type": "float",
            "floating_point_format": "IEEE 754",
            "floating_point_precision": "single precision (32-bit) and double precision (64-bit)"
        },
        "coprocessor": [
            {
                "name": "FPU",
                "architecture": "hayneko_arch32F (inbuilt)",
                "description": "Floating Point Unit for handling floating-point operations."
            },
            {
                "name": "XTU",
                "architecture": "hayneko_arch32X",
                "description": "Extension Unit for handling additional and complex instructions."
            },
            {
                "name": "BMU",
                "architecture": "hayneko_arch32B (hayneko_arch64S native support)",
                "description": "Big Math Unit for handling complex mathematical operations."
            },
            {
                "name": "MMU",
                "architecture": "hayneko_arch32M",
                "description": "Memory Management Unit for handling memory management operations."
            },
            {
                "name": "KCU",
                "architecture": "hayneko_arch32K (inbuilt)",
                "description": "Kernel Control Unit for handling kernel and system-level operations."
            }
        ],
        "pipelining": {
            "pipeline_stages": 7,
            "operations": [
                "Instruction Fetch (IF)",
                "Instruction Get Length (IGL)",
                "Instruction Decode (ID)",
                "Address Calculation (AC)",
                "Execute (EX)",
                "Memory Access (MEM)",
                "Write Back (WB)"
            ],
            "description": "The architecture employs a 7-stage pipeline to enhance instruction throughput and overall performance."
        },
        "out_of_order_execution": {
            "supported": false,
            "description": "Supports out-of-order execution to improve performance by allowing instructions to be processed as resources become available rather than strictly in the order they appear in the instruction stream. Hayneko_Arch32S does not support out-of-order execution yet."
        },
        "virtual_memory": {
            "supported": true,
            "page_size": 4096,
            "address_translation": "two-level paging",
            "description": "Supports virtual memory with a page size of 4KB and uses a two-level paging mechanism for address translation."
        },
        "modes": {
            "user_mode": {
                "level": 3,
                "description": "Standard mode for executing user applications with restricted access to system resources."
            },
            "kernel_mode": {
                "level": 1,
                "description": "Privileged mode for executing operating system code with full access to system resources."
            },
            "hardware_mode": {
                "level": 0,
                "description": "Lowest level mode for direct hardware access and control, typically used for firmware and low-level system tasks."
            }
        }

    },
