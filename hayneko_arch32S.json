    "encode": {
        "OPC": {
            "size": 8,
            "description": "Opcode field, specifies the operation to be performed by the processor."
        },
        "SOP": {
            "size": 4,
            "description": "Sub-Opcode field, specifies a variant of the main opcode operation."
        },

        "DRG": {
            "size": 4,
            "description": "Destination Register field, specifies the register where the result of the operation is stored."
        },
        "SR1": {
            "size": 4,
            "description": "Source Register 1 field, specifies the first source register for the operation."
        },
        "SR2": {
            "size": 4,
            "description": "Source Register 2 field, specifies the second source register for the operation."
        },
        "SR3": {
            "size": 4,
            "description": "Source Register 3 field, specifies the third source register for the operation."
        },

