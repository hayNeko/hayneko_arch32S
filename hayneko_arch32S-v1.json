    "flags": {
        "ZF": {
            "bit_position": 0,
            "mask": "0x00000001",
            "description": "Zero Flag - Set if the result of an operation is zero."
        },
        "CF": {
            "bit_position": 1,
            "mask": "0x00000002",
            "description": "Carry Flag - Set if an arithmetic operation generates a carry out or borrow into the most significant bit."
        },
        "OF": {
            "bit_position": 2,
            "mask": "0x00000004",
            "description": "Overflow Flag - Set if an arithmetic operation results in a signed overflow."
        },
        "NF": {
            "bit_position": 3,
            "mask": "0x00000008",
            "description": "Negative Flag - Set if the result of an operation is negative."
        },
        "DF": {
            "bit_position": 4,
            "mask": "0x00000010",
            "description": "Direction Flag - Controls the direction of string operations (0 = increment, 1 = decrement)."
        },

        "FLZ": {
