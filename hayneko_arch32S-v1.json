    "prefixes": {
        "types": {
            "REX": {
                "length": 1,
                "mnemonic": "REX.XT",
                "format": [
                    "1", "1", "1", "0", ["DRG", "SR1", "SR2", "SR3"]
                ],
                "description": "Register Extension Prefix - if any bits in the REX prefix are set, the instruction extends that register fields to allow access 0-15 -> 16-31 of the 32-bit general-purpose registers, or f0-f15 -> d0-d15 of the"
            },
            "BRH_H": {
                "length": 1,
                "mnemonic": ["BRH_H.NT", "BRH_H.T"],
                "format": [
                    "1", "1", "1", "1", "0", "0", "1", ["BHT"]
                ],
                "description": "Branch Hint Prefix - provides a hint to the processor about the likely direction of a branch instruction to optimize instruction pipelining. Must be used before a branch instruction, or the hint is ignored. It modifies the BH bit in the instruction to indicate whether the branch is likely to be taken or not taken."
            },
            "LOCK": {
                "length": 1,
                "mnemonic": "LOCK",
                "format": [
                    "1", "1", "1", "1", "0", "1", "0", "0"
                ],
                "description": "Lock Prefix - ensures exclusive access to shared memory in multi-processor environments by preventing other processors from accessing the memory location being modified until the operation is complete."
            },
            "ISL": {
                "length": 1,
                "mnemonic": "ISL.L",
                "format": [
                    "1", "1", "0", "1", ["ISL"], ["ISL"], ["ISL"], ["ISL"]
                ],
                "description": "Instruction Specific Length Prefix - specifies the length of the instruction in bytes, from 4 to 16 bytes. Values 0-3 are invalid. This prefix may improve performance by allowing the processor to decode the instruction faster."
            },
            "XTU": {
                "length": 1,
                "mnemonic": "XTU.EN",
                "format": [
                    "1", "1", "1", "1", "0", "1", "0", "1"
                ],
                "description": "Extended Instruction Unit Prefix - the following instruction is executed in XTU."
            },
            "BMU": {
                "length": 1,
                "mnemonic": "BMU.EN",
                "format": [
                    "1", "1", "1", "1", "0", "1", "1", "0"
                ],
                "description": "Big Math Unit Prefix - the following instruction is executed in BMU."
            },
            "DBI": {
                "length": 1,
                "mnemonic": null,
                "format": [
                    "1", "1", "1", "1", "0", "0", "0", "0"
                ],
                "description": "Double Byte Instruction Prefix - escape byte to allow the use of 2-byte instructions."
            },
            "TBI": {
                "length": 1,
                "mnemonic": null,
                "format": [
                    "1", "1", "1", "1", "0", "0", "1", "0"
                ],
                "description": "Triple Byte Instruction Prefix - escape byte to allow the use of 3-byte instructions."
            }
        },
